[Desktop Entry]
Type=Application
Name=Paint9X
GenericName=Image Editor
Comment=Create and edit drawings, the classic way
Exec=paint98 %f
Icon=${SNAP}/meta/gui/paint9x.png
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;GTK;
